# ChhayaRakshak AI — Backend Environment Variables
# Copy this file to .env and fill in your real values.
# NEVER commit the .env file — it is already in .gitignore.

# ── Required for AI Assistant + AI Budget Visualization ───────────────────────
# Google Gemini API key — get a FREE key at:
#   https://aistudio.google.com/app/apikey
#
# Enables:
#   • AI Assistant (Feature 5) — conversational heat-safety guidance
#   • AI Budget Visualization  — photorealistic illustration of proposed interventions
#
# Without this key both features show a clear setup banner.
# Heat Risk, Shade Detection, Vulnerability Map, and Budget Optimizer
# all work WITHOUT this key (they use free/local services).
GEMINI_API_KEY=your_gemini_api_key_here

# ── Optional: Database (SQLite, auto-created if absent) ───────────────────────
DATABASE_URL=sqlite:///./database/chhayarakshak.db

# ── Optional: CORS origins ─────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# Default: http://localhost:5173 (Vite dev server).
ALLOWED_ORIGINS=http://localhost:5173

# ── Personal Health Integration ─────────────────────────────────────────────────
# No new secrets are required for this feature.
# Health profiles are stored in the existing SQLite database under DATABASE_URL.
# Session IDs (anonymous UUIDs) are managed by the browser's localStorage —
# they are never sent to third-party services.

# ── AI Budget Visualization ──────────────────────────────────────────────────
# No additional secrets needed — reuses GEMINI_API_KEY above.
# The image-generation prompt is built server-side from the catalogue only;
# no user-supplied free text, health data, or session IDs are sent to Gemini.
